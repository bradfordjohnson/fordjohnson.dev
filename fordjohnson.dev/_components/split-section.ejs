```{=html}
<div class="content-block">
<% for (const item of items) { %>
  <% if (item.splitSections) { %>
    <% for (const section of item.splitSections) { %>
      <div class="split-section <%= section.flip ? 'flip' : '' %>">
        <div class="split-content">
          <h3 class="split-title"><%- section.header %></h3>
          <p class="split-text"><%- section.text %></p>
        </div>
        <div class="split-image">
          <img src="<%- section['img-url'] %>" alt="<%- section['img-alt'] %>" <%= metadataAttrs(section) %> >
        </div>
      </div>
    <% } %>
  <% } %>
<% } %>
</div>
```